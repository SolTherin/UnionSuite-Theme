{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-m", "http.server", "8777"],
      "port": 8777,
      "url": "http://localhost:8777"
    },
    {
      "name": "static-node",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path'),t={'.html':'text/html','.css':'text/css','.js':'text/javascript','.json':'application/json','.svg':'image/svg+xml','.png':'image/png','.woff2':'font/woff2'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);let x=p.join(process.cwd(),u);if(u.endsWith('/'))x=p.join(x,'index.html');f.readFile(x,(e,d)=>{if(e){r.writeHead(404);return r.end('Not found')}r.writeHead(200,{'Content-Type':t[p.extname(x)]||'application/octet-stream'});r.end(d)})}).listen(8778)"],
      "port": 8778,
      "url": "http://localhost:8778"
    }
  ]
}
