{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/attachments/**",
              "components/casework/**",
              "components/data-display/**",
              "components/data/**",
              "components/feedback/**",
              "components/form/**",
              "components/forms/**",
              "components/indicators/**",
              "components/iqa/**",
              "components/layout/**",
              "components/meetings/**",
              "components/navigation/**",
              "components/notes/**",
              "components/platform/**",
              "components/record-header/**",
              "components/utilities/**",
              "ui_kits/case-management/**",
              "ui_kits/membership-profile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Source Sans 3."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionNavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|key|ref|className|style|children)$/]",
        "message": "<AccordionNavLink> doesn't accept that prop. Declared props: id, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertsPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:alerts|title|style|key|ref|className|style|children)$/]",
