        {
          "activityId": "a2c38f50-32a1-4a71-abe6-d809a4e43452",
          "type": "ExecuteSqlAgainstCloudToolz",
          "name": "SQL_TagsToAdd",
          "displayName": "SQL: Tags To Add (iMIS rows)",
          "description": null,
          "x": null,
          "y": null,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "ExpectedResults",
              "syntax": null,
              "expressions": {
                "Literal": "Result Set"
              }
            },
            {
              "name": "Script",
              "syntax": null,
              "expressions": {
                "Literal": "-- NewTagOrdinals is every tag picked: the ones the file does not have yet\n-- are the rows to insert in iMIS.\nSELECT\n    T.Ordinal AS TagOrdinal,\n    @zcfsID AS ZCFS_ID,\n    @fileOrdinal AS ZCFS_Ordinal\nFROM STRING_SPLIT(@tagOrdinals, ',') S\nINNER JOIN [ZideBar].[Zen_Tags] T\n    ON S.value = T.Ordinal\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM [ZideBar].[Zen_CloudFiles_Tags] Z\n    WHERE Z.TagOrdinal = T.Ordinal\n        AND Z.ZCFS_Ordinal = @fileOrdinal\n)"
              }
            },
            {
              "name": "Parameters",
              "syntax": "JavaScript",
              "expressions": {
                "JavaScript": "JSON.stringify([{Name:\"@zcfsID\",Value:getVariable(\"ZcfsID\")},{Name:\"@fileOrdinal\",Value:activities.EndpointData.Output().Body.FileOrdinal},{Name:\"@tagOrdinals\",Value:String(activities.EndpointData.Output().Body.NewTagOrdinals ?? \"\")}])"
              }
            },
            {
              "name": "Timeout",
              "syntax": null,
              "expressions": {}
