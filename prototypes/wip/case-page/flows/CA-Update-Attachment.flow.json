        {
          "activityId": "28a1f6a4-d58a-4aaa-8dfe-dda79f70ed9d",
          "type": "ExecuteSqlAgainstCloudToolz",
          "name": "SQL_CurrentValues",
          "displayName": "SQL: Current Values and Timestamp",
          "description": null,
          "x": null,
          "y": null,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "ExpectedResults",
              "syntax": null,
              "expressions": {
                "Literal": "Result Set"
              }
            },
            {
              "name": "Script",
              "syntax": null,
              "expressions": {
                "Literal": "-- The signed-in user's local time, for LastUpdatedOn\nDECLARE @EntityCode varchar(255) = COALESCE(\n    (SELECT EntityCode FROM ZenCrm.[Individuals] WHERE ImisId = @loggedInUser),\n    (SELECT OrgCode FROM UnionTemplate.Entities WHERE IsDefault = 1)\n);\n\n-- The file's member (ZCFS_ID), its name and tags as they are now, and the\n-- names of the tags picked: the change history's old and new values. Tags\n-- are compared as sorted names, so their order does not count as a change.\nSELECT\n    [UnionTemplate].fn_GetDateTimeWithTimeZone(@EntityCode) AS Timestamp,\n    I.ImisID AS Zcfs_ID,\n    F.FileName AS OldFileName,\n    ISNULL((SELECT STRING_AGG(Tag.TagName, ', ') WITHIN GROUP (ORDER BY Tag.TagName)\n            FROM (SELECT DISTINCT T.TagName\n                  FROM [ZideBar].[Zen_CloudFiles_Tags] FT\n                  INNER JOIN [ZideBar].[Zen_Tags] T ON T.Ordinal = FT.TagOrdinal\n                  WHERE FT.ZCFS_Ordinal = F.Ordinal) Tag), '') AS OldTags,\n    ISNULL((SELECT STRING_AGG(Tag.TagName, ', ') WITHIN GROUP (ORDER BY Tag.TagName)\n            FROM (SELECT DISTINCT T.TagName\n                  FROM STRING_SPLIT(@tagOrdinals, ',') S\n                  INNER JOIN [ZideBar].[Zen_Tags] T ON S.value = T.Ordinal) Tag), '') AS NewTags\nFROM [ZideBar].[Zen_CloudFiles_Storage] F\nINNER JOIN [ZenCRM].[Individuals] I\n    ON F.CrmID = I.ID\nWHERE F.Ordinal = CAST(@fileOrdinal AS int)"
              }
            },
            {
              "name": "Parameters",
              "syntax": "JavaScript",
              "expressions": {
                "JavaScript": "JSON.stringify([{Name:\"@loggedInUser\",Value:activities.EndpointData.Output().Headers.loggedinpartyid},{Name:\"@fileOrdinal\",Value:activities.EndpointData.Output().Body.FileOrdinal},{Name:\"@tagOrdinals\",Value:String(activities.EndpointData.Output().Body.NewTagOrdinals ?? \"\")}])"
              }
            },
            {
              "name": "Timeout",
              "syntax": null,
              "expressions": {}
            },
            {
              "name": "StrictlySelectOnly",
              "syntax": null,
              "expressions": {}
            }
          ],
          "propertyStorageProviders": {}
        },
        {
          "activityId": "6d700179-8746-405a-a40f-681d073b3732",
          "type": "RunJavaScript",
          "name": "SetVariables",
          "displayName": "JS: Set Variables",
          "description": null,
          "x": null,
