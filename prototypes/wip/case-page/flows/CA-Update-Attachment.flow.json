        {
          "activityId": "42a28a46-cf8e-4706-8bd9-36bc72740eee",
          "type": "ExecuteSqlAgainstCloudToolz",
          "name": "SQL_Filename",
          "displayName": "SQL: Update Filename (and iMIS row)",
          "description": null,
          "x": null,
          "y": null,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "ExpectedResults",
              "syntax": null,
              "expressions": {
                "Literal": "Result Set"
              }
            },
            {
              "name": "Script",
              "syntax": null,
              "expressions": {
                "Literal": "-- Rename in CloudToolz\nUPDATE F\nSET FileName = @fileName,\n    LastUpdatedBy = @loggedInUser,\n    LastUpdatedOn = @timestamp\nFROM [ZideBar].[Zen_CloudFiles_Storage] F\nWHERE Ordinal = @fileOrdinal\n\n-- The row for the iMIS update\nSELECT\n    I.ImisID AS ID,\n    S.Ordinal,\n    S.FileName,\n    S.LastUpdatedBy,\n    S.LastUpdatedOn\nFROM [ZideBar].[Zen_CloudFiles_Storage] S\nINNER JOIN ZenCRM.[Individuals] I\n    ON S.CrmID = I.ID\nWHERE S.Ordinal = @fileOrdinal"
              }
            },
            {
              "name": "Parameters",
              "syntax": "JavaScript",
              "expressions": {
                "JavaScript": "JSON.stringify([{Name:\"@timestamp\",Value:getVariable(\"Timestamp\")},{Name:\"@loggedInUser\",Value:activities.EndpointData.Output().Headers.loggedinpartyid},{Name:\"@fileName\",Value:activities.EndpointData.Output().Body.FileName},{Name:\"@fileOrdinal\",Value:activities.EndpointData.Output().Body.FileOrdinal}])"
              }
            },
            {
              "name": "Timeout",
              "syntax": null,
              "expressions": {}
            },
            {
              "name": "StrictlySelectOnly",
              "syntax": null,
              "expressions": {}
            }
          ],
          "propertyStorageProviders": {}
        },
        {
          "activityId": "2856d09a-0b56-40c0-a18c-88393157c429",
          "type": "ExecuteSqlAgainstCloudToolz",
          "name": "SQL_RemoveTags",
          "displayName": "SQL: Remove Tags (and iMIS rows)",
          "description": null,
          "x": null,
          "y": null,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
