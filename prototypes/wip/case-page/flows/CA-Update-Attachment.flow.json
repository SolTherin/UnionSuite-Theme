        {
          "activityId": "62b0b3f6-d90a-4a67-ba3c-c8a4fae36dd0",
          "type": "RunJavaScript",
          "name": "CreateLogContext",
          "displayName": "JS: Create Log Context",
          "description": null,
          "x": null,
          "y": null,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "Script",
              "syntax": "Literal",
              "expressions": {
                "Literal": "// The attachment's name and tags before and after, for the record's change\n// history (LogChangesToIMIS; usage guide #change-history). The editor sends\n// the record's ID (RecordID: a case's CaseID or an agreement's AgreementID);\n// without one the change is logged against the file's member.\nvar endpoint = activities.EndpointData.Output();\nvar body = endpoint.Body;\nvar oldValues = {\n    \"FileName\": String(getVariable(\"OldFileName\") ?? \"\"),\n    \"Tags\": String(getVariable(\"OldTags\") ?? \"\")\n};\nvar newValues = {\n    \"FileName\": String(body.FileName ?? \"\"),\n    \"Tags\": String(getVariable(\"NewTags\") ?? \"\")\n};\n\n// Only the fields that changed. None: nothing is logged.\nvar fieldsToCompare = [\"FileName\", \"Tags\"].filter(field => oldValues[field] !== newValues[field]);\nsetVariable(\"HasChanges\", fieldsToCompare.length > 0);\n\nvar logContext = {\n    \"Note\": \"Attachment \" + newValues.FileName + \": name and tags updated\",\n    \"Table\": \"Zen_CloudFiles_Storage\",\n    \"UpdateReason\": \"Edit\",\n    \"workflowDefinitionId\": workflowDefinitionId, // provided by CloudToolz\n    \"sourceOrdinal\": Number(body.FileOrdinal)\n};\n\n// An Edit's old values travel as the OldValue JSON string, as a BeyondForm's do.\nvar logChanges = {\n    \"logContext\": logContext,\n    \"fieldsToCompare\": fieldsToCompare,\n    \"body\": {\n        \"FileName\": newValues.FileName,\n        \"Tags\": newValues.Tags,\n        \"OldValue\": JSON.stringify(oldValues)\n    },\n    \"profileID\": String(body.RecordID || getVariable(\"ZcfsID\")),\n    \"updatedByID\": endpoint.Headers.loggedinpartyid\n};\nsetVariable(\"logChanges\", logChanges);"
              }
            },
            {
              "name": "PossibleOutcomes",
              "syntax": null,
              "expressions": {}
            }
          ],
          "propertyStorageProviders": {}
        },
