        {
          "activityId": "2d23add5-76a0-42e1-b993-01cd7161e1aa",
          "type": "ExecuteSqlAgainstCloudToolz",
          "name": "SQL_CopyNewTags",
          "displayName": "SQL: Copy New Tags From iMIS",
          "description": null,
          "x": null,
          "y": null,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "ExpectedResults",
              "syntax": null,
              "expressions": {
                "Literal": "Result Set"
              }
            },
            {
              "name": "Script",
              "syntax": null,
              "expressions": {
                "Literal": "-- The file's tags as iMIS has them, with iMIS's ordinals: only the ones\n-- CloudToolz lacks, and not the tags being removed (iMIS still has them\n-- until iMIS: Remove Tags runs).\nINSERT INTO [ZideBar].[Zen_CloudFiles_Tags] (\n    Ordinal,\n    TagOrdinal,\n    ZCFS_ID,\n    ZCFS_Ordinal\n)\nSELECT\n    JSON_VALUE(J.value, '$.Ordinal'),\n    JSON_VALUE(J.value, '$.TagOrdinal'),\n    JSON_VALUE(J.value, '$.ZCFS_ID'),\n    JSON_VALUE(J.value, '$.ZCFS_Ordinal')\nFROM OPENJSON(@imisTags) J\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM [ZideBar].[Zen_CloudFiles_Tags] Z\n    WHERE Z.Ordinal = JSON_VALUE(J.value, '$.Ordinal')\n)\nAND JSON_VALUE(J.value, '$.TagOrdinal') NOT IN (\n    SELECT LTRIM(S.value)\n    FROM STRING_SPLIT(@removedTagOrdinals, ',') S\n)"
              }
            },
            {
              "name": "Parameters",
              "syntax": "JavaScript",
              "expressions": {
                "JavaScript": "JSON.stringify([{Name:\"@imisTags\",Value:JSON.stringify(activities.IQA_iMISTags.ResultSet())},{Name:\"@removedTagOrdinals\",Value:String(activities.EndpointData.Output().Body.RemovedTagOrdinals ?? \"\")}])"
              }
            },
            {
              "name": "Timeout",
              "syntax": null,
              "expressions": {}
            },
            {
              "name": "StrictlySelectOnly",
              "syntax": null,
              "expressions": {}
            }
          ],
