          "properties": [
            {
              "name": "ExpectedResults",
              "syntax": null,
              "expressions": {
                "Literal": "Result Set"
              }
            },
            {
              "name": "Script",
              "syntax": null,
              "expressions": {
                "Literal": "-- The rows for the iMIS delete\nSELECT T.*\nFROM STRING_SPLIT(@removedTagOrdinals, ',') S\nINNER JOIN [ZideBar].[Zen_CloudFiles_Tags] T\n    ON S.value = T.TagOrdinal\nWHERE ZCFS_Ordinal = @fileOrdinal\n\n-- Remove them in CloudToolz\nDELETE T\nFROM STRING_SPLIT(@removedTagOrdinals, ',') S\nINNER JOIN [ZideBar].[Zen_CloudFiles_Tags] T\n    ON S.value = T.TagOrdinal\nWHERE ZCFS_Ordinal = @fileOrdinal"
              }
            },
            {
              "name": "Parameters",
              "syntax": "JavaScript",
              "expressions": {
                "JavaScript": "JSON.stringify([{Name:\"@removedTagOrdinals\",Value:String(activities.EndpointData.Output().Body.RemovedTagOrdinals ?? \"\")},{Name:\"@fileOrdinal\",Value:activities.EndpointData.Output().Body.FileOrdinal}])"
              }
            },
