        {
          "activityId": "2a3100b8-4df9-4a35-b001-867241513658",
          "type": "RunJavaScript",
          "name": "CreateLogContext",
          "displayName": "JS: Create Log Context",
          "description": null,
          "x": 275,
          "y": 2070,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "Script",
              "syntax": "Literal",
              "expressions": {
                "Literal": "// UPDATE LOG CONTEXT HERE\nvar endpoint = activities.EndpointData.Output();\nvar body = endpoint.Body;\nvar contact = activities.ContactInfo.ResultSet()[0];\n\nvar logContext = {\n    \"Note\": \"Case \" + body.CaseID + \": Quick Add Contact\", // UPDATE HERE\n    \"Table\": \"i4u_UT_Cases_Contacts\", // UPDATE HERE\n    \"UpdateReason\": \"Add\", // UPDATE HERE\n    \"workflowDefinitionId\": workflowDefinitionId, // DON'T UPDATE, VARIABLE IS PROVIDED BY CLOUDTOOLZ\n    \"sourceOrdinal\": activities.iMIS_Insert.ImisOrdinal() // the new case contact's ordinal\n}\n// UPDATE FIELDS YOU WANT TO COMPARE HERE - names must match the keys in logBody below\nvar fieldsToCompare = [\"ContactId\", \"ContactName\", \"ContactType\"];\n\n// The values as written to i4u_UT_Cases_Contacts, under its column names.\n// No OldValue: an Add.\nvar logBody = {\n    \"ContactId\": String(body.ContactID ?? \"\"),\n    \"ContactName\": String(contact.Name ?? \"\"),\n    \"ContactType\": \"Member\"\n}\n// An Add logs only the values given: the logging flow writes a row for every\n// field listed, blank or not.\nfieldsToCompare = fieldsToCompare.filter(field => logBody[field] !== \"\");\n\n// compile all variables into one object\nvar logChanges = {\n    \"logContext\": logContext, // DON'T CHANGE\n    \"fieldsToCompare\": fieldsToCompare, // DON'T CHANGE\n    \"body\": logBody,\n    \"profileID\": String(body.CaseID), // the case the change belongs to\n    \"updatedByID\": endpoint.Headers.loggedinpartyid\n}\nsetVariable('logChanges', logChanges);"
              }
            },
            {
              "name": "PossibleOutcomes",
              "syntax": null,
              "expressions": {}
            }
          ],
