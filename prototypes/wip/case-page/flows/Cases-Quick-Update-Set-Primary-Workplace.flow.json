        {
          "activityId": "8501032d-06f9-4453-93af-ff97fc3cf263",
          "type": "ExecuteSqlAgainstCloudToolz",
          "name": "SQL_Validation",
          "displayName": "SQL - Validation and Timestamp",
          "description": null,
          "x": 40,
          "y": 320,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "ExpectedResults",
