          "properties": [
            {
              "name": "Script",
              "syntax": "Literal",
              "expressions": {
                "Literal": "// UPDATE LOG CONTEXT HERE\r\nvar endpoint = activities.EndpointData.Output();\r\nvar body = endpoint.Body;\r\n\r\nvar logContext = {\r\n    \"Note\": \"Case \" + body.CaseID + \": Set Primary Workplace\", // UPDATE HERE\r\n    \"Table\": \"i4u_UT_Cases\", // UPDATE HERE\r\n    \"UpdateReason\": \"Edit\", // UPDATE HERE\r\n    \"workflowDefinitionId\": workflowDefinitionId, // DON'T UPDATE, VARIABLE IS PROVIDED BY CLOUDTOOLZ\r\n    \"sourceOrdinal\": String(body.CaseNum) // the case's ordinal\r\n}\r\n// UPDATE FIELDS YOU WANT TO COMPARE HERE - names must match the keys in logBody below\r\nvar fieldsToCompare = [\"PrimaryWorkplaceID\"];\r\n\r\n// The case's workplace ID, new and as it was (SQL_Validation reads it\r\n// before the update); blank is not about a workplace.\r\nvar logBody = {\r\n    \"PrimaryWorkplaceID\": String(body.WorkplaceID ?? \"\"),\r\n    \"OldValue\": JSON.stringify({ \"PrimaryWorkplaceID\": String(activities.SQL_Validation.ResultSet()[0].OldPrimaryWorkplaceID ?? \"\") })\r\n}\r\n\r\n// compile all variables into one object\r\nvar logChanges = {\r\n    \"logContext\": logContext, // DON'T CHANGE\r\n    \"fieldsToCompare\": fieldsToCompare, // DON'T CHANGE\r\n    \"body\": logBody,\r\n    \"profileID\": String(body.CaseID), // the case the change belongs to\r\n    \"updatedByID\": endpoint.Headers.loggedinpartyid\r\n}\r\nsetVariable('logChanges', logChanges);"
              }
            },
