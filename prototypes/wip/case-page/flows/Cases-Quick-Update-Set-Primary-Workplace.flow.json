          "properties": [
            {
              "name": "Condition",
              "syntax": "JavaScript",
              "expressions": {
                "JavaScript": "// Blank is \"not about a workplace\". Anything else must be the workplace ID\r\n// of one of the primary contact's jobs (Workplace ID, WorkplaceID or ID,\r\n// matched whatever its case, spaces or underscores).\r\n(() => {\r\n  const id = String(activities.EndpointData.Output().Body.WorkplaceID ?? '').trim();\r\n  if (id === '') return true;\r\n  const key = name => String(name).replace(/[\\s_]/g, '').toLowerCase();\r\n  const get = (row, ...names) => { const column = Object.keys(row).find(name => names.map(key).includes(key(name))); return column === undefined ? undefined : row[column]; };\r\n  return activities.MemberJobs.ResultSet().some(row => String(get(row, 'Workplace ID', 'WorkplaceID', 'ID') ?? '').trim() === id);\r\n})()"
              }
            }
          ],
          "propertyStorageProviders": {}
