            {
              "name": "DataToAssign",
              "syntax": "JavaScript",
              "expressions": {
                "JavaScript": "// The shape the Fileupload flow reads back: Filename and Base64String.\nvar file = activities.StageFile.Output();\nreturn JSON.stringify({ Filename: String(file.FileName), Base64String: String(file.Base64string ?? file.Base64String ?? '') });"
              }
