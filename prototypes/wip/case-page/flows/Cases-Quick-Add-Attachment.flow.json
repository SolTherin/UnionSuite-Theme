        {
          "activityId": "5717cec6-8158-4cef-80c4-70987d7d5f02",
          "type": "RunJavaScript",
          "name": null,
          "displayName": "JS - Build Fileupload Input",
          "description": null,
          "x": 275,
          "y": 2573,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "Script",
              "syntax": null,
              "expressions": {
                "Literal": "// The Fileupload flow's input, as the drag and drop flow builds it for an\n// attachment on a case. Quick-add files are always Open.\nvar endpoint = activities.EndpointData.Output();\nvar json = {\n    \"Files\": JSON.parse(getVariable('FilesJson')),\n    \"FileTags\": JSON.parse(getVariable('TagsJson')),\n    \"EntityCode\": Contact[0].EntityCode,\n    \"NoteOrdinal\": '',\n    \"Date\": getVariable('UploadDate'),\n    \"Case\": {\n        \"CaseOrdinal\": Case[0].CaseOrdinal,\n        \"CaseID\": endpoint.Body.CaseID,\n        \"NewCase\": false,\n        \"CreatedByMember\": false,\n        \"DefaultTagOrdinal\": '',\n        \"Access\": 'Open'\n    },\n    \"Agreement\": null,\n    \"Type\": 'Case',\n    \"Email\": {\n        \"IsEmail\": false\n    },\n    \"User\": {\n        \"StaffIMISID\": endpoint.Headers.loggedinpartyid,\n        \"MemberIMISID\": Contact[0].ID\n    }\n}\nsetVariable('ParentInput', json)"
              }
            },
