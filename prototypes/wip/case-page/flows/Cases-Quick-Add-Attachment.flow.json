        {
          "activityId": "8d3ba8c1-59b0-4b13-ab7f-8fda01a55071",
          "type": "RunJavaScript",
          "name": null,
          "displayName": "JS - Set Tags, Date and File Count",
          "description": null,
          "x": 275,
          "y": 1318,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "Script",
              "syntax": null,
              "expressions": {
                "Literal": "var body = activities.EndpointData.Output().Body;\n\n// Tags: the composer's TagOrdinals (\"15,7\"), plus 3, which the drag and\n// drop flow adds to every case file. Each tag once.\nvar tags = String(body.TagOrdinals ?? '').split(',').map(tag => tag.trim()).filter(tag => tag !== '');\ntags.push('3');\nsetVariable('TagsJson', JSON.stringify(tags.filter((tag, index) => tags.indexOf(tag) === index)));\n\n// The staged files' {UploadName, Uuid}, filled in as each goes into Redis.\nsetVariable('FilesJson', '[]');\n\n// Body.Files is a .NET list or a JS array, depending on how it was read.\nvar files = body.Files;\nsetVariable('FileCount', files == null ? 0 : Number(files.length ?? files.Count ?? 0));\n\n// The Fileupload flow's Date, as the form sends NoteDate: the entity's\n// local time as \"YYYY-MM-DD HH:mm\".\nsetVariable('UploadDate', String(activities.SQL_Validation.ResultSet()[0].Timestamp).slice(0, 16).replace('T', ' '));"
              }
            },
            {
              "name": "PossibleOutcomes",
              "syntax": null,
              "expressions": {}
            }
          ],
          "propertyStorageProviders": {}
        },
