        {
          "activityId": "50e1cf26-a409-4b60-9116-893101146d86",
          "type": "RunJavaScript",
          "name": null,
          "displayName": "JS - Give the File an Upload ID",
          "description": null,
          "x": 40,
          "y": 2071,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "Script",
              "syntax": null,
              "expressions": {
                "Literal": "var file = activities.StageFile.Output();\n\n// guid() where the engine has it, otherwise a random v4 GUID.\nvar uuid = typeof guid === 'function' ? String(guid()) : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n  var r = Math.random() * 16 | 0;\n  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n});\n\nvar files = JSON.parse(getVariable('FilesJson'));\nfiles.push({ UploadName: String(file.FileName), Uuid: uuid });\nsetVariable('FilesJson', JSON.stringify(files));\nsetVariable('StagedUuid', uuid);"
              }
            },
            {
              "name": "PossibleOutcomes",
              "syntax": null,
              "expressions": {}
            }
          ],
          "propertyStorageProviders": {}
        },
        {
          "activityId": "3416366e-1c61-42c5-a1df-be8fdb6c2b3c",
